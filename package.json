{
  "name": "dsh-plugin-strata",
  "version": "1.2.0",
  "description": "One plugin for the local strata stack: strata-hop :8080 model-switching router control, live switch/load monitoring (GUI chip + strata_status tool), warm-on-selection preloading, run-config + shared chat-settings tuning (调参: GUI panel & strata_params tool proxying hop /config and serve /settings; restart-to-apply for run-config, instant for chat settings), and the dsh provider config (incl. Effort levels) to route chats to it.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.bundle.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/monitor.js",
    "lib/params.js",
    "lib/client.js",
    "lib/client.bundle.js",
    "router/strata-hop.py",
    "router/strata-hop.service",
    "router/strata-hop.example.json",
    "README.md",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "react",
        "react/jsx-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-0 <5.0.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.5-0 <3.19.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER_PLACEHOLDER/dsh-plugin-strata.git"
  },
  "homepage": "https://github.com/OWNER_PLACEHOLDER/dsh-plugin-strata#readme",
  "bugs": {
    "url": "https://github.com/OWNER_PLACEHOLDER/dsh-plugin-strata/issues"
  }
}
